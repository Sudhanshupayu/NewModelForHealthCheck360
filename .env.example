# HealthCheck360 Bot Configuration

# API Settings
API_BASE_URL=https://healthcheck360.payu.in
API_TIMEOUT=30

# LLM Provider: "ollama" or "huggingface"
LLM_PROVIDER=ollama

# Ollama Settings (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# HuggingFace Settings (if using HuggingFace)
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=INFO

# Authentication Cookies (optional - override default cookies)
# HEALTHCHECK_COOKIES=cookie1=value1; cookie2=value2
